# 複製這個檔案成 .env，再填入自己的值。.env 不要上傳到 GitHub。

# ---------- Django ----------
DJANGO_DEBUG=1
# 正式上線一定要換成很長的隨機字串：uv run python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 正式網址（https 開頭），例如 https://course.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------- Firebase：前端登入用（主控台 → 專案設定 → 一般 → 你的應用程式 → 網頁應用程式的 firebaseConfig） ----------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=你的專案.firebaseapp.com
FIREBASE_PROJECT_ID=你的專案
FIREBASE_APP_ID=

# ---------- Firebase：伺服器用的服務帳戶金鑰（主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰） ----------
# 把下載的 JSON 放在專案資料夾的 secrets/ 裡（已被 .gitignore 排除）
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# ---------- OpenAI：AI 選課建議 ----------
# 沒填就不顯示 AI 機器人按鈕
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 判斷學系用的模型（可以填更便宜、更快的模型；不填就跟 OPENAI_MODEL 一樣）
OPENAI_MODEL_FAST=
# 每位學生每 10 分鐘最多幾次 AI 請求
AI_RATE_LIMIT=20

# 學校信箱網域
SCHOOL_DOMAIN=ntub.edu.tw

# 額外的老師帳號（老師名單在 data/teachers.txt）：信箱=課程資料上的老師姓名，多組用逗號分隔
# 例如示範用：TEACHER_EXTRA=你的帳號@ntub.edu.tw=蒯思齊
TEACHER_EXTRA=
